diff --git a/src/app/fix_windowed.h b/src/app/fix_windowed.h
new file mode 100644
index 0000000..aea64a6
--- /dev/null
+++ b/src/app/fix_windowed.h
@@ -0,0 +1,39 @@
+/* FIX windowed-mode: the launcher's "Windowed" checkbox and what it needs (not in the original game). */
+#ifndef SDW_APP_FIX_WINDOWED_H
+#define SDW_APP_FIX_WINDOWED_H
+#include "../sdk/windef.h"
+#include "../sdk/win32.h"
+
+extern u8 g_fixWindowed;       /* the checkbox: a window of the chosen resolution instead of fullscreen */
+extern u8 g_fixWindowedActive; /* the device was created windowed (D3DApp::CreateDevice) */
+
+#define IDC_CHK_WINDOWED 1040
+#define FIX_WS_WINDOWED 0x10CA0000 /* WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX: a window that moves */
+#define FIX_WS_CHECKBOX 0x50010003 /* WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX */
+#define FIX_GWL_STYLE (-16)
+#define FIX_SWP_SHOW 0x0064 /* SWP_NOZORDER | SWP_FRAMECHANGED | SWP_SHOWWINDOW */
+#define FIX_WM_MOVE 0x0003
+#define FIX_WM_GETFONT 0x0031
+#define FIX_WM_CTLCOLORSTATIC 0x0138
+#define FIX_NULL_BRUSH 5
+
+extern "C" __declspec(dllimport) long __stdcall SetWindowLongA(HWND hWnd, int index, long value);
+extern "C" __declspec(dllimport) BOOL __stdcall SetWindowPos(HWND hWnd, HWND after, int x, int y, int cx, int cy,
+                                                             UINT flags);
+extern "C" __declspec(dllimport) BOOL __stdcall AdjustWindowRect(RECT *rect, DWORD style, BOOL menu);
+extern "C" __declspec(dllimport) int __stdcall GetSystemMetrics(int index);
+extern "C" __declspec(dllimport) BOOL __stdcall MapDialogRect(HWND dialog, RECT *rect);
+extern "C" __declspec(dllimport) void *__stdcall GetStockObject(int object);
+
+/* the game's window as a window with a title bar whose client area is w x h, centred on the main screen */
+inline void Fix_SizeWindow(HWND hWnd, int w, int h)
+{
+    RECT frame;
+    SetRect(&frame, 0, 0, w, h);
+    AdjustWindowRect(&frame, FIX_WS_WINDOWED, 0);
+    SetWindowLongA(hWnd, FIX_GWL_STYLE, FIX_WS_WINDOWED);
+    SetWindowPos(hWnd, 0, (GetSystemMetrics(0) - (frame.right - frame.left)) / 2,
+                 (GetSystemMetrics(1) - (frame.bottom - frame.top)) / 2, frame.right - frame.left,
+                 frame.bottom - frame.top, FIX_SWP_SHOW);
+}
+#endif
