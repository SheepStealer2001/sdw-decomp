+         * PausedMenu_ClearItems), so each load added two nodes to its 50-node array, and from the 26th load on they were
+         * written past its end, over the pause menu's globals and later the list heap's. */
+        PausedMenu_ClearItems();
         Load_FreeLevel();
         g_scenaricLevelHeap.Term();
         if (g_levelHeapStorage) {
